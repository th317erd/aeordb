# Keep source, contracts, and golden text byte-stable across native checkouts.
.gitattributes text eol=lf
.gitignore text eol=lf
*.agis text eol=lf
*.css text eol=lf
*.hex text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.rs text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Persistent fixtures and packaged assets must never undergo text conversion.
*.aeordb binary
*.bin binary
*.exe binary
*.gif binary
*.gz binary
*.ico binary
*.jpeg binary
*.jpg binary
*.png binary
*.wasm binary
*.webp binary
*.zip binary
*.zst binary
